# SkillMetricScraper — Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env to git.

# ClawHub Registry URL (default: https://clawhub.ai)
# CLAWHUB_BASE_URL=https://clawhub.ai

# GitHub Personal Access Token (for fetching source READMEs)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Anthropic API Key (for YouTube script generation)
# Create at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI API Key (for X/Twitter signal capture via Grok x-search)
# Create at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
